{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.factory/bin/factory-sweep\" \"$CLAUDE_PROJECT_DIR\" --apply >> \"$HOME/.factory/logs/sweep.log\" 2>&1 || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__Sanity__search_docs",
      "mcp__Sanity__read_docs",
      "mcp__Sanity__list_sanity_rules",
      "mcp__Sanity__get_sanity_rules",
      "mcp__Sanity__whoami",
      "mcp__Sanity__list_projects",
      "mcp__Sanity__list_datasets",
      "mcp__Sanity__get_project_studios",
      "mcp__Sanity__list_workspace_schemas",
      "mcp__Sanity__get_schema",
      "mcp__Sanity__list_releases",
      "mcp__Sanity__list_embeddings_indices",
      "mcp__Sanity__query_documents",
      "mcp__Sanity__get_document",
      "mcp__Sanity__semantic_search"
    ]
  }
}
