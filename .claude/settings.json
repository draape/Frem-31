{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.factory/bin/factory-sweep\" \"$CLAUDE_PROJECT_DIR\" --apply >> \"$HOME/.factory/logs/sweep.log\" 2>&1 || true"
          }
        ]
      }
    ]
  }
}