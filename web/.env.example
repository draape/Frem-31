# Feature Switches
# Controls the root page behavior
# - "true": Shows new home page at / (Frembanen accessible at /frembanen)
# - "false": Server-side redirects / to /frembanen
NEXT_PUBLIC_ENABLE_HOME_PAGE=false

# Site
# Absolute origin for canonical and Open Graph URLs. Production is
# https://frembanen.frem-31.no (later https://frem-31.no).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity
# Project id of the frem-31 Sanity project. The Studio at /studio and the
# Sanity CLI (sanity.cli.ts) read these same two variables.
NEXT_PUBLIC_SANITY_PROJECT_ID=auquaqxb
# Dataset to read published content from
NEXT_PUBLIC_SANITY_DATASET=test
# Pinned Content Lake API version (YYYY-MM-DD); bump deliberately
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
